# Nuxe environment template
# Copy this file to .env locally and fill values yourself.
# Never commit .env or put server-only secrets behind a VITE_ prefix.

# Supabase browser configuration (publishable/anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase server configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway (server-side)
LOVABLE_API_KEY=

# Approval email delivery (server-side)
GOOGLE_MAIL_API_KEY=
APPROVAL_OWNER_EMAIL=

# Scheduled/cron endpoint authentication (server-side)
LOVABLE_CRON_SECRET=
# Optional old secret during rotation; remove after rotation is complete.
LOVABLE_CRON_SECRET_PREVIOUS=
